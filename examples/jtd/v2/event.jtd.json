{
  "metadata": {"description": "An event published when a user's account changes."},
  "definitions": {
    "address": {
      "properties": {
        "street": {"type": "string"},
        "city": {"type": "string"},
        "country": {"type": "string"}
      },
      "optionalProperties": {
        "postcode": {"type": "string"}
      }
    }
  },
  "properties": {
    "id": {"type": "string"},
    "at": {"type": "timestamp"},
    "attempts": {"type": "int8"},
    "change": {
      "discriminator": "kind",
      "mapping": {
        "created": {"properties": {"email": {"type": "string"}}},
        "moved": {"properties": {"address": {"ref": "address"}}},
        "closed": {"properties": {"reason": {"enum": ["USER", "FRAUD", "INACTIVE"]}}},
        "renamed": {"properties": {"name": {"type": "string"}}}
      }
    }
  },
  "optionalProperties": {
    "source": {"type": "string"}
  }
}
