#%RAML 1.0 Library
usage: Types and templates shared by the pet APIs.
types:
  Status:
    type: string
    enum: [available, pending, adopted]
traits:
  paged:
    queryParameters:
      limit?:
        type: integer
        minimum: 1
        maximum: 50
      offset?:
        type: integer
        minimum: 0
resourceTypes:
  collection:
    get?:
      is: [paged]
      responses:
        200:
          body: <<item>>[]
    post?:
      body: <<item>>
      responses:
        201:
          body: <<item>>
