/** Places and tracks orders. */
@namespace("example.orders")
protocol Orders {
  import idl "money.avdl";

  enum Status { PLACED, SHIPPED, DELIVERED, RETURNED } = PLACED;

  record Line {
    string sku;
    int quantity;
    example.money.Money price;
  }

  /** An order. */
  record Order {
    string id;
    array<Line> lines;
    Status status = "PLACED";
    string? note = null;
    string? coupon = null;
    timestamp_ms placed;
  }

  error NotFound {
    string id;
  }

  error Suspended {
    string reason;
  }

  Order get(string id) throws NotFound, Suspended;

  string place(Order order);

  void cancel(string id) oneway;
}
